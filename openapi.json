      "get": {
        "summary": "Stocks Oversub",
        "description": "Return oversubscription + frozen capital for stocks with allotment data.\n\nReads the pre-computed stock_analysis_cache (same values as\n/api/stocks/{code}/overview) in one query. Optional ?year=2026 filters\nby listing year.",
