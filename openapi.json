    "/api/stocks/{code}/predict/custom": {
      "get": {
        "summary": "Predict Custom",
        "description": "Compute a single-point allotment prediction for arbitrary oversub/alpha.\n\nUnlike /api/stocks/{code}/predict (default params) and\n/api/predict-agent-grid/{code} (fixed 18x5 grid), this accepts any positive\noversub multiple and any alpha in [0,1], computing the result on demand so\nAI agents can query e.g. \"假设最终超购 300 倍\" directly.\n\nWhen oversub is omitted, defaults to cibo's predicted final oversubscription\nmultiple (model median blended with the margin-broker forecast).",
        "operationId": "get_api_stocks_code_predict_custom",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          },
          {
            "name": "oversub",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Oversub"
            }
          },
          {
            "name": "alpha",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Alpha"
            }
          },
          {
            "name": "agent",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "knn_calibrated",
              "title": "Agent"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
