{
  "openapi": "3.1.0",
  "info": {
    "title": "cibo.hk — HK IPO Allotment Forecasts & Allottee-Profile Analysis",
    "version": "1.0.0",
    "description": "Public HK IPO data API: allotment forecasts, allottee profiles, prospectus details, allotment results, inclusion analysis, rankings, disclosures, full-market directory, and cross-market data. No API key required. See https://cibo.hk/llms.txt for the agent discovery doc and https://cibo.hk/mcp for the MCP server.",
    "x-mcp": "https://cibo.hk/mcp",
    "x-llms": "https://cibo.hk/llms.txt"
  },
